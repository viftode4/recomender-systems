{
  "dataset": "ml-100k",
  "seed": 2026,
  "reproducibility": true,
  "use_gpu": false,
  "eval_args": {
    "split": {"RS": [0.8, 0.1, 0.1]},
    "group_by": "user",
    "order": "RO",
    "mode": "full"
  },
  "metrics": ["Recall", "MRR", "NDCG", "Hit", "Precision"],
  "topk": [10],
  "valid_metric": "MRR@10",
  "epochs": 20,
  "eval_step": 1,
  "stopping_step": 5,
  "train_batch_size": 2048,
  "show_progress": false,
  "worker": 0
}
